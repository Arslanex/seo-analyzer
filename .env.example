# Copy to .env (never commit .env). Only ANTHROPIC_API_KEY is required for the AI layer.
ANTHROPIC_API_KEY=
# Optional
# SEOA_LLM_MODEL=claude-haiku-5-5        # default; claude-sonnet-5-5 is ~20x more expensive, same scores in tests
# SEOA_LLM_BUDGET_USD=8                  # hard cap for ALL LLM spend of this installation (persistent ledger)
# SEOA_GOOGLE_API_KEY=                   # ONE Google Cloud key: CrUX real-user field data (LCP/INP/CLS) + PageSpeed. No site-owner permission needed.
# Search Console (indexing status, queries, clicks): put the OAuth client JSON in data/google_client.json, then press 'Connect with Google' in Settings > Connections (docs/google-setup.md)
# SEOA_OPENPAGERANK_KEY=                # free key from keywordseverywhere.com/account/openpagerank (one IP only): domain authority estimate (third party, not a Google metric)
# SEOA_MAX_PAGES=25                      # default sample size for site audits (cap: SEOA_MAX_PAGES_CAP=200)
# SEOA_RENDER=1                          # 0 disables headless rendering
# SEOA_BOT_NAME=SEOAnalyzerBot/0.1  SEOA_BOT_INFO_URL=https://your.domain/bot
